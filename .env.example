# Copy this file to .env and fill in real values.
# The app refuses to start if a required variable below is missing.

APP_URL=http://localhost:3000          # URL users open; used to build email links + SSO redirect_uri
PORT=3000

MONGODB_URI=mongodb://mongo:27017/its_forms

SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars-long

SELLCENTER_URL=https://digital.in.th   # SSO + org API base URL
ORG_API_TOKEN=                          # service token, scope org:read (leave blank while ORG_API_MOCK=1)

AUTH_MODE=mock                          # sso | mock  -- mock is dev-only, see docs/requirement.md §5.6
ORG_API_MOCK=1                          # 1 = read mock/org/*.json instead of calling sellcenter

ADMIN_EMP_IDS=E001                      # comma-separated emp_ids that are admin from first boot

UPLOAD_DIR=/data/uploads
MAX_FILE_MB=10

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_MODE=console                       # smtp | console -- console just logs instead of sending

TZ=Asia/Bangkok
