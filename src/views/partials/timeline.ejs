<%
// §10.4: "ไทม์ไลน์ทุกเหตุการณ์ทุกรอบ ... รอบเก่าย่อ" — older rounds
// collapse into a <details>, the latest round (plus comments, which
// aren't round-scoped in the data model — §11.3's `comments` sits
// alongside `rounds`, not inside one) stays expanded.
const roundNums = [...new Set(timeline.filter((e) => e.round).map((e) => e.round))].sort((a, b) => a - b);
const latestRound = roundNums[roundNums.length - 1];
const oldRounds = roundNums.filter((r) => r !== latestRound);
const currentEvents = timeline.filter((e) => !e.round || e.round === latestRound);
%>
<section class="timeline-panel no-print">
  <h2>ไทม์ไลน์</h2>

  <% oldRounds.forEach(function (r) { %>
    <details class="timeline-round-details">
      <summary>รอบที่ <%= r %> (ย่อ — คลิกเพื่อดู)</summary>
      <ul class="timeline-list">
        <% timeline.filter(function (e) { return e.round === r; }).forEach(function (ev) { %>
          <%- include('timeline-event', { ev }) %>
        <% }) %>
      </ul>
    </details>
  <% }) %>

  <ul class="timeline-list">
    <% currentEvents.forEach(function (ev) { %>
      <%- include('timeline-event', { ev }) %>
    <% }) %>
    <% if (timeline.length === 0) { %>
      <li class="timeline-empty">ยังไม่มีเหตุการณ์</li>
    <% } %>
  </ul>

  <form method="POST" action="/submissions/<%= submission._id %>/comment" class="comment-form">
    <label for="comment-text">เพิ่มความเห็น</label>
    <textarea id="comment-text" name="text" rows="2" class="a4-input" required></textarea>
    <button type="submit" class="button secondary">ส่งความเห็น</button>
  </form>
</section>
