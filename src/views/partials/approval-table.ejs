<%
// Auto-generated approval table (§8.7) — always the CURRENT round only;
// older rounds belong in the timeline (§8.7: "แสดงเฉพาะรอบปัจจุบันบนกระดาษ").
const RESULT_LABEL = {
  approve: '✔ อนุมัติ',
  reject: '✘ ไม่อนุมัติ',
  return: '↩ ส่งกลับแก้ไข',
};
const round = submission.rounds && submission.rounds.length > 0
  ? submission.rounds[submission.rounds.length - 1]
  : null;
%>
<% if (round) { %>
<table class="a4-approval-table a4-footer-approval-table">
  <thead>
    <tr><th>ขั้น</th><th>ผู้อนุมัติ</th><th>ผล</th><th>วันเวลา</th><th>ความเห็น</th></tr>
  </thead>
  <tbody>
    <tr>
      <td>ผู้จัดทำ</td>
      <td><%= submission.submitter.name %><%= submission.submitter.department ? ' (' + submission.submitter.department.name + ')' : '' %></td>
      <td>ส่งคำร้อง</td>
      <td><%= submission.submittedAt ? formatThaiDate(submission.submittedAt, { withTime: true }) : '' %></td>
      <td></td>
    </tr>
    <% round.steps.forEach(function (step, stepIdx) { %>
      <%
        // §8.3: once a step's quorum is met, whoever hadn't voted yet no
        // longer needs to -- the table says so instead of a misleading
        // "รอ" (§8.7's own example row: "— ไม่ต้องกด (ครบเสียงแล้ว)").
        // A step is "past" once `current` has moved beyond it, or this
        // round has already concluded entirely (current is null).
        const stepIsPast = !submission.current || submission.current.round !== round.round || stepIdx < submission.current.stepIndex;
      %>
      <% step.approvers.forEach(function (approver, idx) { %>
        <% const activeDecisions = step.decisions.filter(function (d) { return d.emp_id === approver.emp_id && !d.recalledAt; }); %>
        <% const decision = activeDecisions[activeDecisions.length - 1]; %>
        <tr>
          <td><%= idx === 0 ? step.name : '' %></td>
          <td><%= approver.name %></td>
          <td>
            <% if (decision) { %><%= RESULT_LABEL[decision.action] || decision.action %>
            <% } else if (stepIsPast) { %>— ไม่ต้องกด (ครบเสียงแล้ว)
            <% } else { %>รอ<% } %>
          </td>
          <td><%= decision ? formatThaiDate(decision.at, { withTime: true }) : '' %></td>
          <td><%= decision && decision.comment ? decision.comment : '' %></td>
        </tr>
      <% }) %>
    <% }) %>
  </tbody>
</table>
<% } %>
