<header class="topbar">
  <a href="/" class="topbar-brand">its-forms</a>
  <nav class="topbar-nav">
    <a href="/inbox">กล่องงาน</a>
  </nav>
  <div class="topbar-user">
    <div class="notif-wrap">
      <button type="button" id="notif-bell" class="link-button" aria-label="การแจ้งเตือน">
        🔔<span id="notif-count" class="notif-count" hidden></span>
      </button>
      <div id="notif-panel" class="notif-panel" hidden>
        <ul id="notif-list" class="notif-list"></ul>
      </div>
    </div>
    <span class="topbar-user-name">
      <%= user.name %><% if (user.nickname) { %> (<%= user.nickname %>)<% } %>
    </span>
    <span class="topbar-user-dept"><%= user.department ? user.department.name : '—' %></span>
    <form method="POST" action="/auth/logout" class="topbar-logout-form">
      <button type="submit" class="link-button">ออกจากระบบ</button>
    </form>
  </div>
</header>
<script src="/js/notifications.js"></script>
