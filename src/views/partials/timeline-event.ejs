<li class="timeline-item timeline-<%= ev.kind %><%= ev.recalled ? ' is-recalled' : '' %>">
  <div class="timeline-time"><%= formatThaiDate(ev.at, { withTime: true }) %></div>
  <div class="timeline-body">
    <% if (ev.kind === 'submitted') { %>
      <strong><%= ev.actorName %></strong> <%= ev.text %>
    <% } else if (ev.kind === 'decision') { %>
      <strong><%= ev.actorName %></strong> <%= ev.actionLabel %> (<%= ev.stepName %>)
      <% if (ev.recalled) { %><span class="timeline-tag">ถูกดึงกลับ</span><% } %>
      <% if (ev.comment) { %><div class="timeline-comment">“<%= ev.comment %>”</div><% } %>
    <% } else if (ev.kind === 'recalled') { %>
      <strong><%= ev.actorName %></strong> ดึงกลับการกระทำที่ขั้น <%= ev.stepName %>
    <% } else if (ev.kind === 'comment') { %>
      <strong><%= ev.actorName %></strong> แสดงความเห็น
      <div class="timeline-comment">“<%= ev.text %>”</div>
    <% } else if (ev.kind === 'cancelled') { %>
      <strong><%= ev.actorName %></strong> ยกเลิกคำร้อง
    <% } %>
  </div>
</li>
