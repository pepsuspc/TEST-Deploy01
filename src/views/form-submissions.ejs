<%- include('partials/head', {title: form.name + ' — คำร้อง'}) %>
<body>
<%- include('partials/topbar', {user}) %>
<main class="page">
  <h1><%= form.name %></h1>
  <%- include('partials/form-design-tabs', { form, tab: 'submissions' }) %>

  <form method="GET" class="action-panel">
    <label>สถานะ
      <select class="a4-input" name="status" style="width:auto;display:inline-block">
        <option value="">ทั้งหมด</option>
        <% ['draft','pending','approved','rejected','cancelled'].forEach(function (s) { %>
          <option value="<%= s %>" <%= query.status === s ? 'selected' : '' %>><%= STATUS_LABEL[s] %></option>
        <% }) %>
      </select>
    </label>
    <label>จาก <input class="a4-input" type="date" name="from" value="<%= query.from || '' %>" style="width:auto;display:inline-block"></label>
    <label>ถึง <input class="a4-input" type="date" name="to" value="<%= query.to || '' %>" style="width:auto;display:inline-block"></label>
    <label>ค้นหาเลขที่ <input class="a4-input" type="text" name="q" value="<%= query.q || '' %>" style="width:auto;display:inline-block"></label>
    <button type="submit" class="button secondary">กรอง</button>
  </form>

  <p><%= submissions.total %> รายการ</p>
  <table class="a4-approval-table">
    <thead><tr><th>เลขที่</th><th>เรื่อง</th><th>ผู้ยื่น</th><th>แผนก</th><th>สถานะ</th><th>ส่งเมื่อ</th></tr></thead>
    <tbody>
      <% submissions.items.forEach(function (s) { %>
        <tr>
          <td><a href="/submissions/<%= s._id %>"><%= s.docNumber || '(ร่าง)' %></a></td>
          <td><%= (s.snapshot && s.snapshot.elements.find(function(e){return e.type==='short_text'})) ? (s.values[s.snapshot.elements.find(function(e){return e.type==='short_text'}).id] || '') : '' %></td>
          <td><%= s.submitter.name %></td>
          <td><%= s.submitter.department ? s.submitter.department.name : '' %></td>
          <td><span class="inbox-status-badge status-<%= s.status %>"><%= STATUS_LABEL[s.status] %></span></td>
          <td><%= s.submittedAt ? formatThaiDate(s.submittedAt) : '' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <% if (submissions.pageCount > 1) { %>
    <div class="pagination">
      <% for (let p = 1; p <= submissions.pageCount; p++) { %>
        <a href="?<%= new URLSearchParams({...query, page: p}).toString() %>" class="<%= p === submissions.page ? 'active' : '' %>"><%= p %></a>
      <% } %>
    </div>
  <% } %>
</main>
<%- include('partials/foot') %>
