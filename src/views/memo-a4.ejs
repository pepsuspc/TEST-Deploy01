<%
// STATUS_LABEL comes from app.locals (domain/statusLabels.js) automatically.
// formName is passed in by the route (formContextFor()) — snapshot once
// submitted, the live form's name for a draft that's never been submitted.
const errs = typeof errors === 'undefined' ? {} : errors;
%>
<%- include('partials/head', {title: formName}) %>
<body>
<%- include('partials/topbar', {user}) %>
<main class="page-a4-container">

  <% if (mode === 'edit') { %>
    <div class="a4-toolbar no-print">
      <button type="button" id="btn-save" class="button secondary" form="memo-form" formaction="/submissions/<%= submission._id %>/save" formmethod="POST">บันทึกร่าง</button>
      <span id="save-status" class="a4-save-status"></span>
      <span style="flex:1"></span>
      <a href="/submissions/<%= submission._id %>" class="button secondary">ดูตัวอย่าง</a>
      <% if (!submission.docNumber) { %>
        <form method="POST" action="/submissions/<%= submission._id %>/delete" onsubmit="return confirm('ลบร่างนี้? ลบแล้วกู้คืนไม่ได้');" style="display:inline">
          <button type="submit" class="button danger">ลบร่าง</button>
        </form>
      <% } %>
      <button type="submit" class="button" form="memo-form" formaction="/submissions/<%= submission._id %>/submit" formmethod="POST">ส่ง</button>
    </div>

    <% if (Object.keys(errs).length > 0) { %>
      <div class="a4-error-summary no-print">กรุณาตรวจสอบ <%= Object.keys(errs).length %> รายการ</div>
    <% } %>
    <% if (typeof blocked !== 'undefined' && blocked) { %>
      <div class="a4-error-summary no-print"><%= blocked %></div>
    <% } %>
  <% } else { %>
    <div class="a4-toolbar no-print">
      <span class="a4-save-status">
        สถานะ: <strong><%= STATUS_LABEL[submission.status] %></strong>
        <% if (submission.docNumber) { %> · <%= submission.docNumber %><% } %>
      </span>
      <span style="flex:1"></span>
      <% if (submission.status === 'draft' && submission.submitter.emp_id === user.emp_id) { %>
        <a href="/submissions/<%= submission._id %>/edit" class="button secondary">แก้ไขร่าง</a>
      <% } %>
      <% if (['approved','rejected','cancelled'].includes(submission.status) && submission.submitter.emp_id === user.emp_id) { %>
        <form method="POST" action="/submissions/<%= submission._id %>/resubmit-from" style="display:inline">
          <button type="submit" class="button secondary">ยื่นใหม่จากใบนี้</button>
        </form>
      <% } %>
      <button type="button" class="button secondary" onclick="window.print()">พิมพ์</button>
    </div>

    <% if (canDecide) { %>
      <div class="action-panel no-print">
        <form method="POST" action="/submissions/<%= submission._id %>/decide">
          <input type="hidden" name="version" value="<%= submission.version %>">
          <label for="decide-comment">ความเห็น <span class="a4-save-status">(บังคับ ≥ 5 ตัวอักษร สำหรับ "ไม่อนุมัติ"/"ส่งกลับแก้ไข")</span></label>
          <textarea id="decide-comment" name="comment" rows="2" class="a4-input"></textarea>
          <div class="action-panel-buttons">
            <button type="submit" name="action" value="approve" class="button">อนุมัติ</button>
            <button type="submit" name="action" value="reject" class="button danger">ไม่อนุมัติ</button>
            <button type="submit" name="action" value="return" class="button secondary">ส่งกลับแก้ไข</button>
          </div>
        </form>
      </div>
    <% } %>
    <% if (canRecall) { %>
      <form method="POST" action="/submissions/<%= submission._id %>/recall" class="action-panel no-print"
            onsubmit="return confirm('ดึงกลับการกระทำล่าสุดของคุณในขั้นนี้?');">
        <input type="hidden" name="version" value="<%= submission.version %>">
        <button type="submit" class="button secondary">ดึงกลับ</button>
      </form>
    <% } %>
    <% if (canCancel) { %>
      <form method="POST" action="/submissions/<%= submission._id %>/cancel" class="action-panel no-print"
            onsubmit="return confirm('ยกเลิกคำร้องนี้? ยกเลิกแล้วกู้คืนไม่ได้');">
        <input type="hidden" name="version" value="<%= submission.version %>">
        <button type="submit" class="button danger">ยกเลิกคำร้อง</button>
      </form>
    <% } %>
  <% } %>

  <form id="memo-form" data-save-url="/submissions/<%= submission._id %>/save" data-submission-id="<%= submission._id %>">
    <input type="hidden" id="version-field" name="version" value="<%= submission.version %>">
  <div class="a4-page-wrap">
    <div class="a4-page">
      <% if (mode === 'view' && submission.status !== 'draft') { %>
        <div class="a4-watermark <%= submission.status === 'pending' ? 'is-neutral' : '' %>">
          <% if (submission.status !== 'approved') { %><%= STATUS_LABEL[submission.status] %><% } %>
        </div>
      <% } else if (mode === 'view' && submission.status === 'draft') { %>
        <div class="a4-watermark is-neutral">ร่าง</div>
      <% } %>

      <div class="a4-letterhead">
        <div class="a4-letterhead-logo"></div>
        <div class="a4-letterhead-company">ชื่อบริษัท (ตัวอย่าง — ตั้งค่าจริงในหน้า admin ของก้อนที่ 4)<br>ที่อยู่บริษัท</div>
      </div>

      <div class="a4-title-bar">
        <div></div>
        <div class="a4-form-title"><%= formName %></div>
        <div class="a4-doc-number"><%= submission.docNumber || '(ยังไม่มีเลขที่)' %></div>
      </div>

      <div class="a4-grid">
        <% elements.forEach(function (el) { %>
          <% const value = submission.values ? submission.values[el.id] : undefined; %>
          <div class="a4-field <%= el.type === 'table' ? 'a4-field-table' : '' %>" style="grid-column: <%= el.col %> / span <%= el.colSpan %>;">

            <% if (el.type === 'short_text') { %>
              <label class="a4-field-label" for="f_<%= el.id %>">
                <%= el.props.label %><% if (el.props.required) { %> <span class="a4-required">*</span><% } %>
              </label>
              <% if (mode === 'edit') { %>
                <input class="a4-input" type="text" id="f_<%= el.id %>" name="values[<%= el.id %>]"
                       maxlength="<%= el.props.maxLength || 200 %>" value="<%= value || '' %>">
              <% } else { %>
                <div class="a4-value <%= el.align === 'right' ? 'a4-align-right' : '' %>"><%= value || '—' %></div>
              <% } %>

            <% } else if (el.type === 'long_text') { %>
              <label class="a4-field-label" for="f_<%= el.id %>">
                <%= el.props.label %><% if (el.props.required) { %> <span class="a4-required">*</span><% } %>
              </label>
              <% if (mode === 'edit') { %>
                <textarea class="a4-input" id="f_<%= el.id %>" name="values[<%= el.id %>]"
                          rows="<%= el.props.rows || 4 %>" maxlength="<%= el.props.maxLength || 5000 %>"><%= value || '' %></textarea>
              <% } else { %>
                <div class="a4-value"><%= value || '—' %></div>
              <% } %>

            <% } else if (el.type === 'select_many') { %>
              <% if (el.props.label) { %>
                <label class="a4-field-label"><%= el.props.label %></label>
              <% } %>
              <% const selected = Array.isArray(value) ? value : []; %>
              <% if (mode === 'edit') { %>
                <div class="a4-checkbox-row">
                  <% el.props.options.forEach(function (opt, i) { %>
                    <label>
                      <input type="checkbox" name="values[<%= el.id %>][]" value="<%= opt %>" <%= selected.includes(opt) ? 'checked' : '' %>>
                      <%= opt %>
                    </label>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="a4-checkmarks">
                  <% el.props.options.forEach(function (opt) { %>
                    <span><%= selected.includes(opt) ? '☑' : '☐' %> <%= opt %></span>
                  <% }) %>
                </div>
              <% } %>

            <% } else if (el.type === 'number') { %>
              <label class="a4-field-label" for="f_<%= el.id %>">
                <%= el.props.label %><% if (el.props.required) { %> <span class="a4-required">*</span><% } %>
              </label>
              <% if (mode === 'edit') { %>
                <input class="a4-input" type="text" inputmode="decimal" id="f_<%= el.id %>" name="values[<%= el.id %>]" value="<%= value ?? '' %>">
              <% } else { %>
                <% const numText = (value === undefined || value === null || value === '') ? '—' : formatNumber(value, el.props.decimals || 0); %>
                <div class="a4-value <%= el.align === 'right' ? 'a4-align-right' : '' %>"><%= el.props.prefix || '' %><%= numText %><%= el.props.suffix ? ' ' + el.props.suffix : '' %></div>
              <% } %>

            <% } else if (el.type === 'date') { %>
              <label class="a4-field-label">
                <%= el.props.label %><% if (el.props.required) { %> <span class="a4-required">*</span><% } %>
              </label>
              <% const dateVal = (value && typeof value === 'object') ? value : {}; %>
              <% if (mode === 'edit') { %>
                <div style="display:flex; gap: 0.5rem; align-items:center;">
                  <input class="a4-input" type="date" name="values[<%= el.id %>][from]" value="<%= dateVal.from || '' %>">
                  <% if (el.props.mode === 'range') { %>
                    <span>ถึง</span>
                    <input class="a4-input" type="date" name="values[<%= el.id %>][to]" value="<%= dateVal.to || '' %>">
                  <% } %>
                </div>
              <% } else { %>
                <div class="a4-value">
                  <%= dateVal.from ? formatThaiDate(dateVal.from) : '—' %><% if (el.props.mode === 'range' && dateVal.to) { %> – <%= formatThaiDate(dateVal.to) %><% } %>
                </div>
              <% } %>

            <% } else if (el.type === 'select_one') { %>
              <label class="a4-field-label">
                <%= el.props.label %><% if (el.props.required) { %> <span class="a4-required">*</span><% } %>
              </label>
              <% if (mode === 'edit') { %>
                <% if (el.props.display === 'radio') { %>
                  <div class="a4-checkbox-row">
                    <% el.props.options.forEach(function (opt) { %>
                      <label><input type="radio" name="values[<%= el.id %>]" value="<%= opt %>" <%= value === opt ? 'checked' : '' %>> <%= opt %></label>
                    <% }) %>
                  </div>
                <% } else { %>
                  <select class="a4-input" name="values[<%= el.id %>]">
                    <option value="">— เลือก —</option>
                    <% el.props.options.forEach(function (opt) { %>
                      <option value="<%= opt %>" <%= value === opt ? 'selected' : '' %>><%= opt %></option>
                    <% }) %>
                  </select>
                <% } %>
              <% } else { %>
                <div class="a4-value"><%= value || '—' %></div>
              <% } %>

            <% } else if (el.type === 'file') { %>
              <label class="a4-field-label">
                <%= el.props.label %><% if (el.props.required) { %> <span class="a4-required">*</span><% } %>
              </label>
              <% const files = Array.isArray(value) ? value : []; %>
              <% if (mode === 'edit') { %>
                <div class="file-field" data-field-id="<%= el.id %>" data-max-files="<%= el.props.maxFiles || 5 %>" data-accept="<%= (el.props.accept || []).join(',') %>">
                  <ul class="file-field-list">
                    <% files.forEach(function (f) { %>
                      <li data-file-id="<%= f.fileId %>"><%= f.name %> (<%= formatFileSize(f.size) %>) <button type="button" class="file-field-remove">ลบ</button>
                        <input type="hidden" name="values[<%= el.id %>][]" value="<%= f.fileId %>"></li>
                    <% }) %>
                  </ul>
                  <input type="file" class="file-field-input no-print">
                  <div class="file-field-status"></div>
                </div>
              <% } else { %>
                <ul class="a4-file-list">
                  <% files.forEach(function (f) { %>
                    <li><a href="/files/<%= f.fileId %>" target="_blank"><%= f.name %></a> (<%= formatFileSize(f.size) %>)</li>
                  <% }) %>
                  <% if (files.length === 0) { %><li>—</li><% } %>
                </ul>
              <% } %>

            <% } else if (el.type === 'table') { %>
              <%- include('partials/table-field', { el, value, mode }) %>

            <% } else if (el.type === 'static') { %>
              <% if (el.props.variant === 'heading') { %>
                <h3 class="a4-static-heading"><%= el.props.text %></h3>
              <% } else if (el.props.variant === 'line') { %>
                <hr class="a4-static-line">
              <% } else { %>
                <p class="a4-static-paragraph"><%= el.props.text %></p>
              <% } %>

            <% } else if (el.type === 'auto') { %>
              <label class="a4-field-label"><%= el.props.label %></label>
              <%
                // §a4-value uses white-space:pre-wrap (to preserve long_text
                // line breaks), so this has to be built as one single-line
                // string — multi-line EJS control flow directly inside the
                // div would leave literal blank lines in the rendered output.
                const rawAuto = submission.autoValues ? submission.autoValues[el.id] : undefined;
                let autoText;
                if (rawAuto === undefined || rawAuto === null) {
                  autoText = '(จะเติมอัตโนมัติตอนส่ง)';
                } else if (el.props.source === 'submitted_at') {
                  autoText = formatThaiDate(rawAuto);
                } else {
                  autoText = String(rawAuto);
                }
              %>
              <div class="a4-value <%= el.align === 'right' ? 'a4-align-right' : '' %>"><%= autoText %></div>
            <% } %>

            <% if (errs[el.id]) { %>
              <div class="a4-field-error"><%= errs[el.id] %></div>
            <% } %>
          </div>
        <% }) %>
      </div>

      <%- include('partials/approval-table', { submission }) %>

      <div class="a4-page-number no-print">หน้า 1/1</div>
    </div>
  </div>
  </form>

  <% if (mode === 'view') { %>
    <%- include('partials/timeline', { timeline, submission, user }) %>
  <% } %>
</main>
<% if (mode === 'edit') { %>
  <script src="/js/autosave.js"></script>
  <script src="/js/file-field.js"></script>
  <script src="/js/table-field.js"></script>
<% } %>
<%- include('partials/foot') %>
